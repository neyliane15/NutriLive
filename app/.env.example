# ---- Banco (Neon) -------------------------------------------------------
# Crie um projeto em neon.tech, copie a connection string "pooled".
DATABASE_URL=postgresql://user:senha@ep-xxx.sa-east-1.aws.neon.tech/nutrielive?sslmode=require

# ---- Aplicação ----------------------------------------------------------
APP_URL=http://localhost:8787
SESSION_SECRET=troque-por-32-bytes-aleatorios-em-producao
NODE_ENV=development

# ---- Mercado Pago -------------------------------------------------------
# Painel do Mercado Pago > Suas integrações > Credenciais.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_WEBHOOK_SECRET=assinatura-do-webhook-configurada-no-painel

# ---- E-mail (Resend, ou qualquer SMTP) ----------------------------------
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Nutri&Live <oi@nutrielive.com.br>"

# ---- IA via n8n ---------------------------------------------------------
N8N_BASE_URL=https://seu-n8n.app.n8n.cloud
N8N_WEBHOOK_TOKEN=token-compartilhado-entre-app-e-n8n

# ---- Armazenamento de arquivos (Cloudflare R2, opcional no início) ------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nutrielive
