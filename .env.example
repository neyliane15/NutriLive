# =============================================================================
# Nutri&Live — variáveis de ambiente
#
# Copie para `.env` (que o git ignora) e preencha. Em desenvolvimento TUDO tem
# padrão: sem nenhuma destas, o sistema sobe com banco em memória, dados de
# demonstração, pagamento simulado, IA local e e-mail no log.
#
# Em produção (NODE_ENV=production) o sistema RECUSA subir sem as quatro
# primeiras. O motivo de cada uma está em `app/server/lib/env.ts`.
# =============================================================================

# --- Obrigatórias em produção -----------------------------------------------

# Chave do HMAC da sessão e dos links de e-mail. 32+ bytes aleatórios.
# Gere com:  openssl rand -base64 48
SESSION_SECRET=

# Postgres. Na Neon, use a string "pooled" e acrescente ?sslmode=require
DATABASE_URL=

# O endereço público do app. É o que monta o link do e-mail de primeiro acesso:
# apontando para localhost, o cliente que pagou recebe um link que não abre.
APP_URL=https://app.seudominio.com.br

# E-mail. "console" escreve a mensagem no log em vez de enviar — bom para
# desenvolver, desastroso em produção: o link de primeiro acesso só existiria
# no log, e quem pagou não entraria.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Nutri&Live <oi@seudominio.com.br>

# --- Pagamento ---------------------------------------------------------------
# Sem MP_ACCESS_TOKEN o checkout usa o provedor simulado (cartão de teste,
# Pix que cai sozinho). Com ele, é o Mercado Pago de verdade.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# --- Renovação do Pix --------------------------------------------------------
# Segredo do agendador que chama /api/cron/renovacoes. Sem ele a rota recusa
# tudo. Na Vercel, o Cron Job manda este valor em `Authorization: Bearer`.
# Gere com:  openssl rand -hex 32
CRON_SECRET=

# --- IA ----------------------------------------------------------------------
# Sem N8N_BASE_URL a IA usa o gerador local determinístico (sem rede).
# Com ele, os fluxos de `n8n/`. O token é o MESMO nos dois lados.
N8N_BASE_URL=
N8N_WEBHOOK_TOKEN=

# --- Comissão da academia parceira ------------------------------------------
# Em pontos-base: 2000 = 20%.
COMMISSION_RATE_BP=2000

# --- Rede --------------------------------------------------------------------
# 1 quando houver proxy na frente (Vercel, Cloudflare, balanceador) reescrevendo
# X-Forwarded-For. Sem isso o limite de tentativas e a auditoria aceitariam o IP
# que o cliente mandasse.
TRUST_PROXY=1
